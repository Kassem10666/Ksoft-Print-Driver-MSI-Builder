;
; Destination Directories
;

[DestinationDirs]
DefaultDestDir=66000

V5PRINTPROC_PKG_FILES =66001

V5LRS_PKG_FILES=66000

;
; Localizable Strings
;
[Strings]
Disk1="Xerox Pull Print"

PscriptCopySection="Copy_Pscript_FE_Redist"
PscriptOemCopyFiles="PSCRIPT_FE.OEM"


