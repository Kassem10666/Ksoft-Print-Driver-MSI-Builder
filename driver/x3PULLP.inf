[Version]
Signature="$Windows NT$"
Provider="Xerox"
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Class=Printer
PnpLockdown=1

CatalogFile=x3PULLP.cat

DriverVer=11/27/2024,51035.200.0.0

DriverIsolation=2 

;
; OEM URLS:
;

[OEM URLS]
"Xerox"="http://www.xerox.com"

;
; Manufacturer section.
;

[Manufacturer]
"Xerox"=Models, NTamd64, NTamd64.6.0

; Print Processor
[V5PRINTPROC_PKG_FILES]
x5print.dll
x5pp.dll

; Lrs
[V5LRS_PKG_FILES]
x5lrsl.dll
x5lrs.dll

[PrinterPackageInstallation.amd64]
PackageAware=TRUE

CoreDriverDependencies={D20EA372-DD35-4950-9ED8-A6335AFE79F1}

;
; Model sections. 
; 
; Each section here corresponds with an entry listed in the
; [Manufacturer] section, above. The models will be displayed in the order
; that they appear in the INF file.
;

[Install_PULLP_PS_NoRedist.Services]
AddService =, 0x2

[Install_PULLP_PS_NT60.Services]
AddService =, 0x2

[Models.NTamd64]

"Xerox Pull Print Driver PS"     = Install_PULLP_PS_NoRedist,WSDPRINT\Xerox_HWID_V3PULL1,USBPRINT\Xerox_HWID_V3PULL1,Xerox_HWID_V3PULL1

"Xerox PullPrn PS V5.1035.2.0"     = Install_PULLP_PS_NoRedist,WSDPRINT\Xerox_HWID_V3PULL2,USBPRINT\Xerox_HWID_V3PULL2,Xerox_HWID_V3PULL2

[Models.NTamd64.6.0]

"Xerox Pull Print Driver PS"     = Install_PULLP_PS_NT60,WSDPRINT\Xerox_HWID_V3PULL1,USBPRINT\Xerox_HWID_V3PULL1,Xerox_HWID_V3PULL1

"Xerox PullPrn PS V5.1035.2.0"     = Install_PULLP_PS_NT60,WSDPRINT\Xerox_HWID_V3PULL2,USBPRINT\Xerox_HWID_V3PULL2,Xerox_HWID_V3PULL2

;
; Install Sections
;

[Install_PULLP_PS_NoRedist]

PrintProcessor="XeroxV5Print,x5print.dll"

DataFile=xPULLP080.p3p

DataSection=PSCRIPT_DATA
Include=NTPRINT.INF

CopyFiles=COPY_DATA_FILES,COPY_NON_PKG_OEM_FILES,V5PRINTPROC_PKG_FILES,V5LRS_PKG_FILES

Needs=%PscriptOemCopyFiles%,PSCRIPT_DATA

[Install_PULLP_PS_NT60]

PrintProcessor="XeroxV5Print,x5print.dll"

DataFile=xPULLP080.p3p

CoreDriverSections="{D20EA372-DD35-4950-9ED8-A6335AFE79F1},%PscriptOemCopyFiles%,PSCRIPT_DATA",  

CopyFiles=COPY_DATA_FILES,COPY_NON_PKG_OEM_FILES,V5PRINTPROC_PKG_FILES,V5LRS_PKG_FILES


;
; Copy Sections
;

[COPY_DATA_FILES]

xPULLP080.p3p
xPULLP080.ini
xPULLP080.cfg

x2PULL.ppd

[COPY_NON_PKG_OEM_FILES]
x3up080.dll
x3rps080.dll
x3wftu080.dll
x3gui080.dll
x3core080.dll
x3util080.dll
x3rnut080.dll
x3coms080.dll
x3jobt080.exe
x3thpr080.exe
x3ptpc080.dll
x3fput080.dll
x3txt080.cab
xPULLP.tag

xPULLp23.cfg
xPULLp0U.cfg
xPULLpTU.cfg
xPULLpUK.cfg
xPULLpVP.cfg
xPULLpWU.cfg
xPULLpXP.cfg
xPULLpYZ.cfg
xPULLpUC.cfg
xPULLpZO.cfg
xPULLpUY.cfg
xPULLp0N.cfg
xPULLp2J.cfg
xPULLpVN.cfg

x3PULL080.cab 

