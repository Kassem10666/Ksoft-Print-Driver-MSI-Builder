;  Location of source files not in Layout.inf.
;

[SourceDisksNames]
100 = %Disk1%
200 = %Disk1%

[SourceDisksFiles]
x3up080.dll = 100
x3rps080.dll = 100
x3wftu080.dll = 100
x3gui080.dll = 100
x3core080.dll = 100
x3util080.dll = 100
